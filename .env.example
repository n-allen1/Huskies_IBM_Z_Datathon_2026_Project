# DispatchZ environment variables. Copy to `.env` (git-ignored) and adjust.
#
# The API reads the process environment; it does NOT load this file by itself.
#   Local shell:  set -a; . ./.env; set +a
#   Docker:       docker run --env-file .env ...
# Comments must be on their own line (Docker does not strip trailing comments).
# Nothing here is a secret except DB_PASSWORD, which you must never commit.

# --- Backend API (all optional; the values shown are the defaults) -----------------------------------
# Enables POST /api/v1/admin/demo/reset.
DEMO_MODE=false
# How long a pending recommendation stays reviewable.
RECOMMENDATION_TTL_SECONDS=300
# Speed assumed by the straight-line ETA fallback.
ASSUMED_SPEED_KMH=40
# Incident classifier: keyword (rules only) or embedding (pretrained model; needs PyTorch, as in the Docker image).
CLASSIFIER=keyword
# Where the embedding model runs: cpu, or nnpa (Telum accelerator; falls back to cpu if unavailable).
EMBEDDING_DEVICE=cpu
# float16 is the dtype the NNPA backend accelerates.
EMBEDDING_DTYPE=float32
# Below this top similarity the classifier suggests no category.
EMBEDDING_MIN_SIMILARITY=0.75
# ETA estimator: haversine (straight line) or xgboost (needs xgboost; trained at start-up on synthetic data).
ETA_MODEL=haversine

# --- Database tooling only (database/alembic, database/seed.py). The API does not use PostgreSQL yet. ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=responsematch
DB_USER=rm_user
DB_PASSWORD=
