{
  "name": "dispatchz-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "mock:fixtures": "node mock/fixture-server.mjs",
    "mock:seed": "node mock/fixture-server.mjs --seed",
    "gen:types": "openapi-typescript ../contracts/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.30",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
