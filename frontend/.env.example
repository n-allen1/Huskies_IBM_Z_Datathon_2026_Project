# Dev proxy target for /api. Prism mock by default; backend is http://localhost:8000.
# For stable, realistic UI work (fixed data, working event stream) run `npm run mock:fixtures` and use http://localhost:4011.
VITE_API_TARGET=http://localhost:4010
# Demo bearer token. Mock and demo adapter only; not production authentication.
VITE_DEMO_TOKEN=demo-dispatcher
